<?xml version="1.0" encoding="utf-8"?>
<!--
  Controla el caché de IIS para esta app (Create React App).

  - index.html: SIN caché. Es el archivo que referencia el bundle JS/CSS con hash
    (ej. main.6f8dde0d.js); si el navegador lo cachea, sigue apuntando al bundle
    viejo aunque el servidor ya tenga uno nuevo, y los cambios "no se ven".
  - /static/*: caché larga. Estos archivos llevan un hash en el nombre que cambia
    en cada build, así que cachearlos agresivamente es seguro (un cambio de código
    siempre genera un nombre de archivo distinto).
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <!-- IIS no sirve .apk sin un MIME type registrado (da 404.3). -->
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
          <add name="Pragma" value="no-cache" />
          <add name="Expires" value="0" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- El APK no lleva hash en el nombre: sin caché para que siempre baje la versión nueva. -->
  <location path="WMSAPP.apk">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
